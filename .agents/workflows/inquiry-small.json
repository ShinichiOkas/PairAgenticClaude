{
  "model": "inquiry-small",
  "description": "inquiry-small の成果物 DAG（役 5 ／ 機械 4 ／ 人間ゲート 1）",
  "levels": [
    [
      "要求"
    ],
    [
      "仕様"
    ],
    [
      "受入検査仕様",
      "調査結果"
    ],
    [
      "提出版",
      "設計保証",
      "非回帰の合否"
    ],
    [
      "受入検査報告書"
    ],
    [
      "残留リスク報告"
    ]
  ],
  "nodes": {
    "要求": {
      "target": "要求",
      "role": "機械（要求）",
      "task": "normalize_request",
      "by": "machine",
      "agentType": "inquiry-small-normalize-request",
      "gate": null,
      "path": "upstream/要求.md",
      "deps": [
        {
          "name": "要望",
          "node": "要望",
          "kind": "必須",
          "path": "inbox/要望.md"
        },
        {
          "name": "用語資産?",
          "node": "用語資産",
          "kind": "任意",
          "path": "inbox/用語資産.md"
        }
      ],
      "blocks": [
        "調査結果",
        "提出版"
      ],
      "post": [
        "要望に現れた曖昧な語が**すべて**定義されている（入力と突き合わせて検査できる・P-16）",
        "定義は「含むもの」と「含まないもの」の両方を書いている",
        "確定は人間の回答による。自分で定義を選んでいない",
        "**問いに依存関係が付いている**（上位に答えると下位が確定するか消える）"
      ],
      "out": [
        "曖昧な語ごとの定義（含むもの／含まないものまで）",
        "確認の問い —— **疑問形であること**（P-13）",
        "理由（入力に無かった知識・判断の由来）＋ 残留リスク"
      ],
      "skills": []
    },
    "仕様": {
      "target": "仕様",
      "role": "仕様作成者",
      "task": "write_specification",
      "by": "agent",
      "agentType": "inquiry-small-write-specification",
      "gate": null,
      "path": "upstream/仕様.md",
      "deps": [
        {
          "name": "要求",
          "node": "要求",
          "kind": "必須",
          "path": "upstream/要求.md"
        },
        {
          "name": "調査対象?",
          "node": "調査対象",
          "kind": "任意",
          "path": "inbox/調査対象.md"
        },
        {
          "name": "差し戻し指示_v(m-1)",
          "node": "差し戻し指示",
          "kind": "前版",
          "path": "差し戻し指示.md"
        }
      ],
      "blocks": [
        "調査結果",
        "提出版",
        "受入検査仕様"
      ],
      "post": [
        "不足なし —— 要求の項目が黙って落ちていない",
        "過剰なし —— 要求と用語定義から**導出できない**問いを足していない（P-24）",
        "各項目が判定手続きに落とせる（検査するのは 受入検査仕様 の担い手）",
        "「答えられない」と判定した項目は範囲外として上げている",
        "**暫定**として置いた項目には、**解除条件**（誰が何を答えたら差し替えるか）が付いている"
      ],
      "out": [
        "**何に答えるか** —— 要求を 100% 説明する問いの一覧",
        "答えられない問いは**理由と扱い**（スコープ外／延期／代案／不可能／**暫定**）",
        "答えの形の制約（何をもって「答えた」とするか。粒度・根拠の要求水準）",
        "理由 ＋ 残留リスク"
      ],
      "skills": [
        "判定可能な仕様の書き方",
        "対象ドメイン知識",
        "扱いの型の使い分け"
      ]
    },
    "受入検査仕様": {
      "target": "受入検査仕様",
      "role": "受入検査設計者",
      "task": "design_acceptance_tests",
      "by": "agent",
      "agentType": "inquiry-small-design-acceptance-tests",
      "gate": null,
      "path": "acceptance/受入検査仕様.md",
      "deps": [
        {
          "name": "仕様",
          "node": "仕様",
          "kind": "必須",
          "path": "upstream/仕様.md"
        },
        {
          "name": "差し戻し指示_v(j-1)",
          "node": "差し戻し指示",
          "kind": "前版",
          "path": "差し戻し指示.md"
        }
      ],
      "blocks": [
        "調査結果",
        "提出版"
      ],
      "post": [
        "仕様の各項目に判定手続きが対応している（網羅）",
        "**「対応している」の定義を満たしている** —— 手続きが no を出す ⟺ 仕様項目が満たされていない",
        "上流の成果物が自分の事後条件を破っていたら、勝手に読み替えず「暫定」として扱い、解除条件を付けている",
        "判定が二値である",
        "**提出版だけで判定できる**（調査者の筋道に依存しない・ブラックボックス）"
      ],
      "out": [
        "仕様の各項目に対応する判定手続き",
        "判定手続きに落とせなかった仕様項目の一覧",
        "**各判定手続きが、対応する仕様項目のどこを判定できないか**（部分的な取りこぼし）",
        "理由 ＋ 残留リスク"
      ],
      "skills": [
        "同値分割",
        "境界値分析"
      ]
    },
    "調査結果": {
      "target": "調査結果_v(n)",
      "role": "調査者",
      "task": "investigate",
      "by": "agent",
      "agentType": "inquiry-small-investigate",
      "gate": null,
      "path": "調査結果.md",
      "deps": [
        {
          "name": "仕様",
          "node": "仕様",
          "kind": "必須",
          "path": "upstream/仕様.md"
        },
        {
          "name": "調査対象",
          "node": "調査対象",
          "kind": "必須",
          "path": "inbox/調査対象.md"
        },
        {
          "name": "調査結果_v(n-1)",
          "node": "調査結果",
          "kind": "前版",
          "path": "調査結果.md"
        },
        {
          "name": "差し戻し指示_v(n-1)",
          "node": "差し戻し指示",
          "kind": "前版",
          "path": "差し戻し指示.md"
        }
      ],
      "blocks": [
        "受入検査仕様"
      ],
      "post": [
        "仕様の各項目に答えが対応している（不足なし・過剰なし）",
        "**すべての主張に、調査対象内の所在が付いている。**原典に無いものは「推測」と明記している",
        "**推測を事実として書いていない**（P-4 の「入力に無かった知識」はここに現れる）",
        "**調べていない範囲が明示されている**（「全部見た」で終わらせない）",
        "**「答えと根拠」と「作業メモ・理由」が節として分かれている**"
      ],
      "out": [
        "**仕様の問いごとの答え**",
        "**根拠** —— 各答えについて、調査対象のどこに書かれているか（原典の所在と引用）",
        "**調べたが答えが出なかった問い**（空でなければ 差し戻し指示 の材料になる）",
        "**調べていない範囲**（何を見なかったか。見れば答えが変わりうるか）",
        "理由（入力に無かった知識・判断の由来）＋ 残留リスク"
      ],
      "skills": [
        "対象ドメイン知識",
        "未カバー領域の言語化",
        "証拠の採取"
      ]
    },
    "設計保証": {
      "target": "設計保証",
      "role": "調査者",
      "task": "assure_design",
      "by": "agent",
      "agentType": "inquiry-small-assure-design",
      "gate": null,
      "path": "upstream/設計保証.md",
      "deps": [
        {
          "name": "調査結果_v(n)",
          "node": "調査結果",
          "kind": "必須",
          "path": "調査結果.md"
        },
        {
          "name": "仕様",
          "node": "仕様",
          "kind": "必須",
          "path": "upstream/仕様.md"
        }
      ],
      "blocks": [
        "受入検査仕様"
      ],
      "post": [
        "提出版から検められる項目を含んでいない（受入検査の仕事を重複させない）",
        "**主張だけの項目が無い。**すべてにエビデンスが付いている",
        "**エビデンスが、調査結果を読まずに検められる形になっている**",
        "仕様に無い項目を保証していない（P-23）"
      ],
      "out": [
        "**提出版からは検められない仕様項目の一覧**（なぜ検められないかつき）",
        "各項目について「どう満たしたか」の主張 ＋ **エビデンス**",
        "**保証できなかった項目** —— 残留リスクへ移す"
      ],
      "skills": [
        "エビデンスの設計",
        "保証範囲の切り出し"
      ]
    },
    "提出版": {
      "target": "提出版",
      "role": "機械（提出版）",
      "task": "publish",
      "by": "machine",
      "agentType": "inquiry-small-publish",
      "gate": null,
      "path": "提出版.md",
      "deps": [
        {
          "name": "調査結果_v(n)",
          "node": "調査結果",
          "kind": "必須",
          "path": "調査結果.md"
        }
      ],
      "blocks": [],
      "post": [
        "調査結果から決定的に得られている（内容を足していない）"
      ],
      "out": [
        "答えと根拠だけを外に出した版（作業メモ・調査ログ・調査者の理由を落とす）"
      ],
      "skills": []
    },
    "受入検査報告書": {
      "target": "受入検査報告書",
      "role": "受入検査実施者",
      "task": "execute_acceptance_tests",
      "by": "agent",
      "agentType": "inquiry-small-execute-acceptance-tests",
      "gate": null,
      "path": "acceptance/受入検査報告書.md",
      "deps": [
        {
          "name": "提出版",
          "node": "提出版",
          "kind": "必須",
          "path": "提出版.md"
        },
        {
          "name": "受入検査仕様",
          "node": "受入検査仕様",
          "kind": "必須",
          "path": "acceptance/受入検査仕様.md"
        },
        {
          "name": "設計保証",
          "node": "設計保証",
          "kind": "必須",
          "path": "upstream/設計保証.md"
        },
        {
          "name": "実行環境",
          "node": "実行環境",
          "kind": "必須",
          "path": "inbox/実行環境.md"
        }
      ],
      "blocks": [
        "調査結果"
      ],
      "post": [
        "受入検査仕様の各項目に結果が対応している",
        "合否が二値である",
        "カバーできなかった領域が明示されている（「全部通った」で終わらせない）",
        "欠陥を見つけても直していない —— 合否を no にして差分に書く。修正は 調査結果 の再作成に回す",
        "**設計保証の各項目に、受理／不受理が付いている**",
        "**設計保証を読んだことで、受入検査仕様の項目を増減させていない**",
        "**受理したが自分では検証していない項目**を、残留リスクに移している",
        "**実施が他人の成果物に書き込んでいない** —— `提出版` を作業空間へ複製して実施する"
      ],
      "out": [
        "合否（二値）",
        "差分 —— どの項目がどう外れたか",
        "実施条件 —— いつ・何を・どう突き合わせたか、**そして実施が環境に何を残したか**",
        "カバーできなかった領域（**入力に無い**。実施して初めて分かる）",
        "残留リスク（何が起こりうるか ＋ 何を確かめていないか）"
      ],
      "skills": [
        "保証の受理",
        "未カバー領域の言語化",
        "残留リスクの書き方"
      ]
    },
    "非回帰の合否": {
      "target": "非回帰の合否",
      "role": "機械（非回帰の合否）",
      "task": "run_regression",
      "by": "machine",
      "agentType": "inquiry-small-run-regression",
      "gate": null,
      "path": "checks/非回帰の合否.md",
      "deps": [
        {
          "name": "調査結果_v(n)",
          "node": "調査結果",
          "kind": "必須",
          "path": "調査結果.md"
        },
        {
          "name": "調査結果_v(n-1)",
          "node": "調査結果",
          "kind": "前版",
          "path": "調査結果.md"
        }
      ],
      "blocks": [],
      "post": [
        "決定論的である。**前版に在った答えが今版で消えていたら不合格**"
      ],
      "out": [],
      "skills": []
    },
    "残留リスク報告": {
      "target": "残留リスク報告",
      "role": "機械（残留リスク報告）",
      "task": "aggregate_residual_risk",
      "by": "machine",
      "agentType": "inquiry-small-aggregate-residual-risk",
      "gate": null,
      "path": "checks/残留リスク報告.md",
      "deps": [
        {
          "name": "要求",
          "node": "要求",
          "kind": "必須",
          "path": "upstream/要求.md"
        },
        {
          "name": "仕様",
          "node": "仕様",
          "kind": "必須",
          "path": "upstream/仕様.md"
        },
        {
          "name": "受入検査仕様",
          "node": "受入検査仕様",
          "kind": "必須",
          "path": "acceptance/受入検査仕様.md"
        },
        {
          "name": "調査結果_v(n)",
          "node": "調査結果",
          "kind": "必須",
          "path": "調査結果.md"
        },
        {
          "name": "受入検査報告書",
          "node": "受入検査報告書",
          "kind": "必須",
          "path": "acceptance/受入検査報告書.md"
        }
      ],
      "blocks": [],
      "post": [
        "各コア成果物の残留リスクが漏れなく集約されている"
      ],
      "out": [],
      "skills": []
    }
  },
  "human": [
    {
      "target": "差し戻し指示",
      "gate": null,
      "path": "差し戻し指示.md"
    }
  ]
}
