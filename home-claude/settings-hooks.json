{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/agent_watch_reminder.py\" || python3 \"$HOME/.claude/hooks/agent_watch_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
